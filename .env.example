# 1 = no browser window. leave empty to watch the run.
HEADLESS=

# The cart scenarios file in the data folder. Leave empty for cart_scenarios.json.
# Another file needs the same scenario ids (fiveItems, fewerThanFive, noneFound, nextPage).
SCENARIOS_FILE=

# Only the AliExpress login tests need these. Without them they are skipped.
# They also need a person to drag the captcha slider (see the README).
ALI_USERNAME=
ALI_PASSWORD=
# off = ignore the account above and skip those tests, so the run never waits for the captcha.
ALI_LOGIN=
